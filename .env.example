VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
VITE_EXTERNAL_ROUTES_URL=https://example.com/open-routes
VITE_ENABLE_OSM_SOURCES=true
VITE_ENABLE_YANDEX_RASP=true
VITE_YANDEX_RASP_API_KEY=your_yandex_rasp_key
VITE_ENABLE_AVIATIONSTACK=true
VITE_AVIATIONSTACK_API_KEY=your_aviationstack_key
VITE_ENABLE_CBR_RATES=true
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# Для Amvera задайте те же VITE_* в разделе "Переменные" проекта.

# --- Только для Edge Functions (не VITE_): задать в Supabase → Project Settings → Edge Functions → Secrets
# или: npx supabase secrets set CORS_ALLOWED_ORIGINS=https://ваш-сайт.ru,http://localhost:5173
# Список разрешённых Origin для браузерных запросов к functions (auth-login, browser-search, …).
# Если не задано, в коде используются localhost/127.0.0.1 :5173 и :4173 (в т.ч. для e2e).
